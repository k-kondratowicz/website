Options +FollowSymLinks -MultiViews
RewriteEngine On
RewriteBase /

# Canonical URL in one hop: anything that isn't https://www.kkondratowicz.pl
# (http on either host, or https on the bare domain) -> https://www.
# Behind a TLS-terminating proxy/CDN, replace the HTTPS line with:
#   RewriteCond %{HTTP:X-Forwarded-Proto} !https [OR]
RewriteCond %{HTTP_HOST} ^(www\.)?kkondratowicz\.pl$ [NC]
RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} ^kkondratowicz\.pl$ [NC]
RewriteRule ^ https://www.kkondratowicz.pl%{REQUEST_URI} [R=301,L,NE]

# /index.html, /foo/index.php -> /, /foo/  (only on direct requests, not internal rewrites)
RewriteCond %{THE_REQUEST} ^[A-Z]+\s/([^?\s]*/)?index\.(php|html?)[?\s] [NC]
RewriteRule ^(.*/)?index\.(php|html?)$ /$1 [R=301,L,NC]

ErrorDocument 404 /404.html
#ErrorDocument 403 /403.html

AddDefaultCharset utf-8

<IfModule mod_mime.c>
	AddType text/javascript              .js .mjs
	AddType font/woff2                   .woff2
	AddType font/woff                    .woff
	AddType image/svg+xml                .svg
	AddType image/webp                   .webp
	AddType image/avif                   .avif
	AddType application/manifest+json    .webmanifest

	AddCharset utf-8 .atom .css .geojson .js .mjs .json .jsonld \
	                 .manifest .rss .vtt .webmanifest .xml
</IfModule>

<IfModule mod_deflate.c>
	<IfModule mod_filter.c>
		AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml \
			text/javascript application/javascript application/json \
			application/ld+json application/manifest+json application/xml \
			application/rss+xml application/atom+xml image/svg+xml
	</IfModule>
</IfModule>

<IfModule mod_expires.c>
	ExpiresActive on
	ExpiresDefault                              "access plus 1 month"

	# HTML & data: always revalidate
	ExpiresByType text/html                     "access plus 0 seconds"
	ExpiresByType text/xml                      "access plus 0 seconds"
	ExpiresByType application/xml               "access plus 0 seconds"
	ExpiresByType application/json              "access plus 0 seconds"
	ExpiresByType application/manifest+json     "access plus 1 week"

	# Favicon
	ExpiresByType image/x-icon                  "access plus 1 week"
	ExpiresByType image/vnd.microsoft.icon      "access plus 1 week"

	# Media
	ExpiresByType image/gif                     "access plus 1 month"
	ExpiresByType image/png                     "access plus 1 month"
	ExpiresByType image/jpeg                    "access plus 1 month"
	ExpiresByType image/webp                    "access plus 1 month"
	ExpiresByType image/avif                    "access plus 1 month"
	ExpiresByType image/svg+xml                 "access plus 1 month"
	ExpiresByType video/mp4                     "access plus 1 month"
	ExpiresByType video/webm                    "access plus 1 month"
	ExpiresByType video/ogg                     "access plus 1 month"
	ExpiresByType audio/ogg                     "access plus 1 month"

	# Fonts
	ExpiresByType font/woff2                    "access plus 1 year"
	ExpiresByType font/woff                     "access plus 1 year"
	ExpiresByType font/ttf                      "access plus 1 year"
	ExpiresByType font/otf                      "access plus 1 year"
	ExpiresByType application/vnd.ms-fontobject "access plus 1 year"

	# CSS & JS: 1 year is only safe if filenames/URLs are versioned
	# (style.3f9a.css or style.css?v=12). Otherwise use "access plus 1 week".
	ExpiresByType text/css                      "access plus 1 year"
	ExpiresByType text/javascript               "access plus 1 year"
	ExpiresByType application/javascript        "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
	# Security headers ("always" = also sent on redirects and error pages)
	Header always set Strict-Transport-Security "max-age=31536000" "expr=%{HTTPS} == 'on'"
	Header always set X-Content-Type-Options "nosniff"
	Header always set X-Frame-Options "SAMEORIGIN"
	Header always set Referrer-Policy "no-referrer"
	Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
	#Header always set Content-Security-Policy "default-src 'self'; frame-ancestors 'self'"

	# "merge", not "set" - "set" wipes the max-age written by mod_expires
	Header merge Cache-Control "no-transform"

	Header set Timing-Allow-Origin "*"

	# Cross-origin access for web fonts only
	<FilesMatch "\.(eot|otf|tt[cf]|woff2?)$">
		Header set Access-Control-Allow-Origin "*"
	</FilesMatch>

	Header always unset X-Powered-By
	Header unset ETag
</IfModule>

FileETag None
ServerSignature Off
